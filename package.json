{
  "name": "cutucao-bot",
  "version": "1.4.0",
  "description": "🐕 cutuCÃO — Bot Discord do ASSERT Lab (CIn-UFPE) para acompanhamento de orientandos",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && ENV_FILE=.env.dev node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fsevents": false
  }
}
