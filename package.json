{
  "name": "cutucao-bot",
  "version": "1.3.0",
  "description": "🐕 cutuCÃO — Bot Discord do ASSERT Lab (CIn-UFPE) para acompanhamento de orientandos",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "DOTENV_CONFIG_PATH=.env.dev ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fsevents": false
  }
}
